# Copy to .env — the app loads it automatically on startup (see
# loadDotEnv in cmd/server/main.go). A real environment variable (from
# your shell, or docker-compose.yml's `environment:`) always wins over
# whatever is set here, so this is just a local-dev convenience.

ADDR=:8080
DATABASE_URL=postgres://campus_forum:campus_forum@localhost:5432/campus_forum?sslmode=disable
JWT_SECRET_FILE=jwt.secret
UPLOAD_DIR=uploads
# Used to build absolute links in emails (verification, password reset).
# Defaults to http://localhost<ADDR> if unset.
BASE_URL=http://localhost:8080
# Locks down CORS for a real deployment; "*" (the default) is fine for
# local dev where the frontend and API are same-origin anyway.
CORS_ALLOWED_ORIGIN=*
# Comma-separated emails to promote to the admin role on every startup.
# There's no API for granting admin — only this env var can.
ADMIN_EMAILS=
# Comma-separated domains (no "@") registration is restricted to. Also
# defaults to "sdu.edu.kz" when this key is absent entirely (not just
# when it's "sdu.edu.kz" here) — set it to an explicit empty value to
# allow any domain instead, e.g. for local testing with throwaway
# addresses.
ALLOWED_EMAIL_DOMAINS=sdu.edu.kz

# --- Email (verification codes, password reset codes, thread-subscriber
# notifications) --- With SMTP_HOST unset, the app logs what it would
# have sent instead of actually sending (see internal/mailer) — handy for
# local dev, since you can just read the token out of the server log.
# Fill these in to send for real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
