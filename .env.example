# Copy this file to .env and fill it in. .env is gitignored — never commit it.
# Every value is optional; with this file untouched the app still runs.

# --- Email (verification and password reset codes) ---
# Leave SMTP_HOST empty and codes are shown on screen instead (testing only).
# Gmail: SMTP_HOST=smtp.gmail.com, and an "app password"
# (https://myaccount.google.com/apppasswords) written without spaces —
# not your normal Gmail password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SDU Helpdesk <your-address@gmail.com>

# --- Admins ---
# Comma-separated emails that get the admin role on every startup.
ADMIN_EMAILS=

# --- Website ---
# Port the website is served on (http://localhost:3000 by default).
WEB_PORT=3000
# Public address of the website, used in links inside emails.
PUBLIC_URL=http://localhost:3000

# --- Database ---
# Password for the database user. Change it for a real server — but only
# before the first start: Postgres sets it once, when the database is created.
DB_PASSWORD=campus_forum

# --- Frontend (npm run dev only) ---
# true = forum and FAQ use built-in demo data, no backend needed.
# VITE_USE_MOCK_API=true
