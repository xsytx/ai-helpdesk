# Copy this file to .env and fill it in. .env is gitignored — never commit it.
# Every value is optional; with this file untouched the app still runs.

# --- Email (verification and password reset codes) ---
# Leave SMTP_HOST empty and codes are shown on screen instead (testing only).
# Gmail: SMTP_HOST=smtp.gmail.com, and an "app password"
# (https://myaccount.google.com/apppasswords) written without spaces —
# not your normal Gmail password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SDU Helpdesk <your-address@gmail.com>

# --- Admins ---
# Comma-separated emails that get the admin role (admin panel + moderation).
# These emails may register from any domain (e.g. a team Gmail); students
# still need an @sdu.edu.kz address.
ADMIN_EMAILS=

# --- Website ---
# Port the website is served on (http://localhost:3000 by default).
WEB_PORT=3000
# Public address of the website, used in links inside emails.
PUBLIC_URL=http://localhost:3000

# --- Database ---
# Password for the database user. Change it for a real server — but only
# before the first start: Postgres sets it once, when the database is created.
DB_PASSWORD=campus_forum

# --- AI assistant (chat answers + forum moderation) ---
# Ollama model to use; it must be pulled first (`ollama pull <name>`).
# qwen3.5:4b (3.3 GB) fits a 4 GB GPU. Bigger models need more GPU memory,
# or part of them runs on the CPU and answers get much slower.
LLM_MODEL=qwen3.5:4b
# Where Ollama runs. The default reaches Ollama installed on this computer.
# OLLAMA_URL=http://host.docker.internal:11434
# Max length of an answer in tokens. Lower = faster on a slow computer.
# LLM_NUM_PREDICT=450
# true: every new question/answer is checked by the AI before it appears.
# While the AI is off, posts wait for a moderator. Set false to skip checks.
MODERATION_ENABLED=true
# AI chats with no new message for this many days are deleted (pinned chats
# are kept). 0 = keep all chats forever.
# CHAT_RETENTION_DAYS=30

# --- Frontend (npm run dev only) ---
# true = forum and FAQ use built-in demo data, no backend needed.
# VITE_USE_MOCK_API=true
