# ---- LLM: локальная Ollama (по умолчанию) ----
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
# Адрес Ollama. Оставьте пустым для http://127.0.0.1:11434
LLM_BASE_URL=
# Ключ нужен только для LLM_PROVIDER=openai или gemini
LLM_API_KEY=
# Таймаут одного запроса к модели (сек). На CPU qwen3:4b отвечает 10-60 сек.
LLM_TIMEOUT_SECONDS=120
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=350
LLM_KEEP_ALIVE=30m

# ---- Поиск по базе знаний ----
# Сколько похожих вопросов показывать модели и с какого косинусного сходства брать кандидата.
# Модель e5 даёт «шумовой фон» ~0.80, поэтому порог ниже 0.80 бессмыслен.
# Окончательное решение «подходит ли ответ» принимает LLM, а не этот порог.
KB_TOP_K=5
KB_CANDIDATE_FLOOR=0.82
# Если LLM недоступна: отдать ответ базы напрямую, когда сходство >= этого значения
KB_SOURCE_ONLY_MIN=0.90
KB_DEVICE=cpu
KB_BATCH_SIZE=16

# ---- Сервис ----
KB_CONTEXT_FILE=config/university_context.txt
KB_REQUEST_LOG=data/logs/requests.sqlite3
KB_INDEX_DIR=data/index
KB_MAX_CONCURRENCY=2
KB_QUEUE_TIMEOUT_SECONDS=120
